{
  "type": "page",
  "name": "page",
  "hash": "",
  "scrollable": true,
  "safeArea": false,
  "padding": "15",
  "align": "null",
  "backgroundColor": "null",
  "onShow": "// run when show page \n",
  "children": {
    "visual": [],
    "nonVisual": []
  },
  "validator": {
    "version": 2,
    "name": {
      "type": "String",
      "regex": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "state": ""
    },
    "scrollable": {
      "type": "Boolean",
      "regex": "^(true|false)$",
      "state": "input"
    },
    "safeArea": {
      "type": "Boolean",
      "regex": "^(true|false)$",
      "state": "input"
    },
    "padding": {
      "type": "String|Number",
      "regex": "^\\d+(,\\d+){0,3}$",
      "state": "input"
    },
    "align": {
      "type": "String|Align",
      "regex": "^(null|left|right|center)$",
      "state": "input"
    },
    "hash": {
      "type": "Invisible"
    },
    "backgroundColor": {
      "type": "String|Color",
      "regex": "^(Colors\\.[a-z]*|Color\\(0x([0-9A-Fa-f]{8}\\))$",
      "state": "input"
    },
    "onShow": {
      "type": "Code",
      "regex": "",
      "state": ""
    },
    "children": {
      "type": "Object",
      "regex": "",
      "state": ""
    }
  }
}